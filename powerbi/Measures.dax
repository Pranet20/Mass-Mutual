/* =========================================================================
   Corporate Travel Analytics — Production DAX Measure Library
   Governed Source: vw_travel
   Base Currency: INR
   Client: MassMutual Financial Group (PS-04 Specification)
   ========================================================================= */

// -------------------------------------------------------------------------
// 1. Core Financial Spend Measures
// -------------------------------------------------------------------------

// 1.1 Total Gross Booking Spend (All Ingested Records)
Total Spend = 
SUM(vw_travel[amount_inr])

Total Spend INR = 
SUM(vw_travel[amount_inr])

// 1.2 Total Net Realized Travel Spend (Only Flown / Travelled Tickets)
Total Completed Spend INR = 
CALCULATE(
    SUM(vw_travel[amount_inr]),
    vw_travel[travelled_flag] = "Y"
)

// 1.3 Spend by Business Group (INR)
Spend by Business Group = 
SUM(vw_travel[amount_inr])

// 1.4 Cross-Border Travel Spend (INR)
Cross-Border Spend INR = 
CALCULATE(
    SUM(vw_travel[amount_inr]),
    vw_travel[trip_classification] = "Cross-Border",
    vw_travel[travelled_flag] = "Y"
)

// 1.5 Domestic Travel Spend (INR)
Domestic Spend INR = 
CALCULATE(
    SUM(vw_travel[amount_inr]),
    vw_travel[trip_classification] = "Domestic",
    vw_travel[travelled_flag] = "Y"
)

// 1.6 Multi-Country Travel Spend (INR)
Multi-Country Spend INR = 
CALCULATE(
    SUM(vw_travel[amount_inr]),
    vw_travel[trip_classification] = "Multi-Country",
    vw_travel[travelled_flag] = "Y"
)

// 1.7 Cross-Border Spend Percentage of Completed Spend
Cross-Border Spend % = 
DIVIDE(
    [Cross-Border Spend INR],
    [Total Completed Spend INR],
    0
)


// -------------------------------------------------------------------------
// 2. Core Volume & Reconciled Distinct Trip Measures (PS-04 Trip Grain vs Ticket Leg Grain)
// -------------------------------------------------------------------------
// GRAIN RECONCILIATION AUDIT NOTE:
// In vw_travel, the grain of each row is an individual TICKET LEG (Fact Grain: 394 records).
// Multi-leg itineraries share a common `trip_id` (Trip Grain: 280 distinct trips).
// When analysing by `travelled_flag`:
//   - 164 trips are Fully Flown (all legs 'Y')
//   -  60 trips are Fully Cancelled (all legs 'N')
//   -  56 trips are Mixed (multi-leg trips with at least one 'Y' and one 'N' leg)
// Total Distinct Trips = 164 + 60 + 56 = 280.
// Trips with Travelled Legs (Any Leg 'Y') = 164 + 56 = 220.
// Trips with Cancelled Legs (Any Leg 'N') = 60 + 56 = 116.
// Note: 220 + 116 = 336 (> 280) because the 56 mixed trips appear in both sets.
// Ticket Leg Grain (Strictly Partitioned):
//   Completed Ticket Legs (260) + Cancelled Ticket Legs (134) = 394 Total Tickets.
// Spend Grain (Strictly Partitioned):
//   Completed Spend (₹16,823,590.00) + Cancelled Spend (₹8,058,920.00) = ₹24,882,510.00.
// -------------------------------------------------------------------------

// 2.1 Total Distinct Trips (Primary PS-04 Trip Metric: 280)
Total Trips = 
DISTINCTCOUNT(vw_travel[trip_id])

// 2.2 Trips with Realized Travel (At least one leg flown: 220)
Trips with Travelled Legs = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    vw_travel[travelled_flag] = "Y"
)

// Legacy alias for backward compatibility
Travelled Trips = [Trips with Travelled Legs]

// 2.3 Trips with Cancelled Legs (At least one leg cancelled/refunded: 116)
Trips with Cancelled Legs = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    vw_travel[travelled_flag] = "N"
)

// Legacy alias for backward compatibility
Non-Travelled Trips = [Trips with Cancelled Legs]

// 2.4 Fully Flown Trips (100% legs flown 'Y', zero 'N' legs: 164)
Fully Flown Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    FILTER(
        VALUES(vw_travel[trip_id]),
        CALCULATE(COUNTROWS(vw_travel), vw_travel[travelled_flag] = "N") = 0
    )
)

// 2.5 Fully Cancelled Trips (100% legs cancelled 'N', zero 'Y' legs: 60)
Fully Cancelled Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    FILTER(
        VALUES(vw_travel[trip_id]),
        CALCULATE(COUNTROWS(vw_travel), vw_travel[travelled_flag] = "Y") = 0
    )
)

// 2.6 Partially Cancelled Trips (Mixed trips with both 'Y' and 'N' legs: 56)
Partially Cancelled Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    FILTER(
        VALUES(vw_travel[trip_id]),
        CALCULATE(COUNTROWS(vw_travel), vw_travel[travelled_flag] = "Y") > 0 &&
        CALCULATE(COUNTROWS(vw_travel), vw_travel[travelled_flag] = "N") > 0
    )
)

// -------------------------------------------------------------------------
// Ticket Leg Grain Measures (Row-Level Fact Grain: 394 Records)
// -------------------------------------------------------------------------

// 2.7 Total Ingested Ticket Leg Records (394)
Total Tickets = 
COUNTROWS(vw_travel)

// 2.8 Completed / Flown Ticket Legs Count (260)
Completed Travel Tickets = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[travelled_flag] = "Y"
)

// 2.9 Cancelled or Refunded Ticket Legs Count (134)
Cancelled or Refunded Tickets = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[travelled_flag] = "N"
)

// 2.10 Domestic Distinct Trips Count (79)
Domestic Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    vw_travel[trip_classification] = "Domestic"
)

// 2.11 Cross-Border Distinct Trips Count (164)
Cross-Border Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    vw_travel[trip_classification] = "Cross-Border"
)

// 2.12 Multi-Country Distinct Trips Count (37)
Multi-Country Trips = 
CALCULATE(
    DISTINCTCOUNT(vw_travel[trip_id]),
    vw_travel[trip_classification] = "Multi-Country"
)

// 2.13 Ticket Status Breakdown
Cancelled Tickets Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[ticket_status] = "CANCELLED"
)

Refunded Tickets Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[ticket_status] = "REFUNDED"
)

Exchanged Tickets Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[ticket_status] = "EXCHANGED"
)


// -------------------------------------------------------------------------
// 3. Required PS-04 Analytical Visual Measures
// -------------------------------------------------------------------------

// 3.1 Non-Negotiable Requirement A: Trips by Month
Trips by Month = 
DISTINCTCOUNT(vw_travel[trip_id])

// 3.2 Non-Negotiable Requirement B: Trips by Business Group
Trips by Business Group = 
DISTINCTCOUNT(vw_travel[trip_id])

// 3.3 Non-Negotiable Requirement C: Trips by Travel Summary
Trips by Travel Summary = 
DISTINCTCOUNT(vw_travel[trip_id])


// -------------------------------------------------------------------------
// 4. Efficiency, Unit Cost & Utilization Measures
// -------------------------------------------------------------------------

// 4.1 Average Spend Per Ingested Trip
Average Trip Spend = 
DIVIDE(
    [Total Spend],
    [Total Trips],
    0
)

// 4.2 Average Ticket Cost (INR)
Average Ticket Cost INR = 
DIVIDE(
    [Total Completed Spend INR],
    [Completed Travel Tickets],
    0
)

// 4.3 Spend Per Realized / Travelled Trip
Spend per Travelled Trip = 
DIVIDE(
    [Total Completed Spend INR],
    [Travelled Trips],
    0
)

// 4.4 Total Approved Quarterly Allowance Baseline (₹1,50,000 INR per employee)
Total Quarterly Allowance INR = 
DISTINCTCOUNT(vw_travel[employee_id]) * 150000.0

// 4.5 Budget Utilization Percentage
Budget Utilization % = 
DIVIDE(
    [Total Completed Spend INR],
    [Total Quarterly Allowance INR],
    0
)


// -------------------------------------------------------------------------
// 5. Governance, Audit & Compliance Measures
// -------------------------------------------------------------------------

// 5.1 Manual Overrides Count
Override Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[override_applied] = 1
)

Manual Overrides Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[override_applied] = 1
)

// 5.2 Manual Override Rate
Override Rate = 
DIVIDE(
    [Override Count],
    COUNTROWS(vw_travel),
    0
)

// 5.3 Policy Flagged Tickets Count (Exceptions / Non-Compliant)
Flagged Tickets Count = 
CALCULATE(
    COUNTROWS(vw_travel),
    vw_travel[policy_compliance_status] <> "COMPLIANT"
)

// 5.4 Policy Compliance Rate Percentage
Policy Compliance Rate % = 
1 - DIVIDE(
    [Flagged Tickets Count],
    [Total Tickets],
    0
)

Policy Violation Rate % = 
DIVIDE(
    [Flagged Tickets Count],
    [Total Tickets],
    0
)


// -------------------------------------------------------------------------
// 6. Time Intelligence (For Import Mode with DimDate Table)
// -------------------------------------------------------------------------

// 6.1 Quarter-over-Quarter Flown Spend Growth %
QoQ Spend Growth % = 
VAR CurrentQtrSpend = [Total Completed Spend INR]
VAR PriorQtrSpend = 
    CALCULATE(
        [Total Completed Spend INR],
        DATEADD(vw_travel[travel_date], -1, QUARTER)
    )
RETURN
    DIVIDE(
        CurrentQtrSpend - PriorQtrSpend,
        PriorQtrSpend,
        0
    )
