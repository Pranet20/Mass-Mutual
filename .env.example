# =========================================================================
# Corporate Travel Analytics & Governance Platform — Environment Configuration
# =========================================================================

# Database Connection (PostgreSQL for production; SQLite for local offline development)
# PostgreSQL Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
# SQLite Example: sqlite:///backend/database/travel_analytics.db
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5433/travel_analytics

# Authentication & Security (Rotate in production; never commit secret keys)
JWT_SECRET_KEY=your_strong_random_jwt_secret_key_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External AI Intelligence Engine (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Server Configuration
PORT=8000
HOST=0.0.0.0
ENV=development

# CORS Governance (Comma-separated list of trusted client origins)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173

# =========================================================================
# Microsoft Power BI Embedded Configuration (Optional / Enterprise)
# =========================================================================
# Model: App Owns Data (Service Principal) or User Owns Data
POWERBI_EMBED_TYPE=app_owns_data

# Microsoft Entra ID (Azure AD) Service Principal Credentials
POWERBI_TENANT_ID=your_microsoft_entra_tenant_id_here
POWERBI_CLIENT_ID=your_azure_ad_app_client_id_here
POWERBI_CLIENT_SECRET=your_azure_ad_app_client_secret_here

# Power BI Workspace & Report Identifiers
POWERBI_WORKSPACE_ID=your_powerbi_workspace_guid_here
POWERBI_REPORT_ID=your_powerbi_report_guid_here

# Direct 1-Click Launch Web URL (Optional web fallback)
POWERBI_REPORT_WEB_URL=https://app.powerbi.com/groups/your_workspace_id/reports/your_report_id

